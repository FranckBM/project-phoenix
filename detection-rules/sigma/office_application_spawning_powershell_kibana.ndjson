{"id": "1e524c83-38d5-440d-b248-67ab9b209473", "name": "SIGMA - Office Application Spawning PowerShell", "enabled": true, "throttle": "no_actions", "interval": "5m", "author": ["Franck B."], "description": "Detects a Microsoft Office or LibreOffice application spawning PowerShell, a common macro-based execution technique.", "rule_id": "1e524c83-38d5-440d-b248-67ab9b209473", "false_positives": ["Legitimate Office/LibreOffice add-ins or automation scripts that shell out to PowerShell (uncommon in most environments)"], "from": "now-5m", "immutable": false, "license": "DRL", "output_index": "", "meta": {"from": "1m"}, "max_signals": 100, "risk_score": 73, "severity": "high", "risk_score_mapping": [], "severity_mapping": [], "threat": [{"tactic": {"id": "TA0002", "reference": "https://attack.mitre.org/tactics/TA0002", "name": "Execution"}, "framework": "MITRE ATT&CK", "technique": [{"id": "T1059", "reference": "https://attack.mitre.org/techniques/T1059", "name": "Command and Scripting Interpreter", "subtechnique": [{"id": "T1059.001", "reference": "https://attack.mitre.org/techniques/T1059/001", "name": "PowerShell"}]}]}], "tags": [], "to": "now", "references": ["https://attack.mitre.org/techniques/T1059/001/", "https://attack.mitre.org/techniques/T1204/002/"], "version": 1, "exceptions_list": [], "related_integrations": [], "required_fields": [], "setup": "", "type": "eql", "language": "eql", "index": ["apm-*-transaction*", "auditbeat-*", "endgame-*", "filebeat-*", "logs-*", "packetbeat-*", "traces-apm*", "winlogbeat-*", "-*elastic-cloud-logs-*"], "query": "any where (winlog.event_data.ParentImage like~ (\"*\\\\winword.exe\", \"*\\\\excel.exe\", \"*\\\\powerpnt.exe\", \"*\\\\soffice.bin\")) and (winlog.event_data.Image like~ (\"*\\\\powershell.exe\", \"*\\\\pwsh.exe\"))", "filters": [], "actions": []}
